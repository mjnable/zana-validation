{
    "name": "mj-zana/validation",
    "description": "Attribute-based validation of objects for Zana applications",
    "type": "library",
    "keywords": ["zana", "validation", "validator", "constraints", "attributes"],
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Validation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Validation\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
