{
    "name": "zana/validation",
    "description": "Validation rules and contracts for Zana applications",
    "type": "library",
    "keywords": ["zana", "validation", "validator", "rules"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Validation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Validation\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

