{
    "name": "mj-zana/validation",
    "description": "Attribute-based validation of objects for Zana applications",
    "type": "library",
    "keywords": [
        "zana",
        "validation",
        "validator",
        "constraints",
        "attributes"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "mj-zana/core": "^2.0",
        "mj-zana/http": "^2.10",
        "mj-zana/mediator": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "mj-zana/core": "To register the Validator with ValidationServiceProvider",
        "mj-zana/http": "To answer a ValidationException with a 422 and its field errors",
        "mj-zana/mediator": "To validate every command and query with ValidationBehavior"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Validation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Validation\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures.php"
        ]
    },
    "repositories": [
